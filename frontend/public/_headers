# Cloudflare Pages honors this file the same way Netlify does. Without it,
# Cloudflare's edge was applying a long (s-maxage=604800, 7-day) cache to
# at least one SPA route (/internship) while leaving others fresh —
# whatever the exact cause, this makes the intended behavior explicit
# instead of relying on Cloudflare's default heuristics per-path.
#
# HTML documents (every route, since this is a single-page app resolved
# through _redirects' SPA fallback) must always revalidate — no edge/CDN
# caching of the shell, so a new deploy is visible immediately everywhere.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Build assets are content-hashed by CRA/webpack (filename changes on every
# build), so these ARE safe to cache aggressively and immutably — this is
# what keeps the site fast; only the HTML shell above needs to stay fresh.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker scripts must never be cached and must be served as JavaScript
# (not the SPA index.html the "/*" _redirects fallback would otherwise return).
# The old-path workers (sw.js / service-worker.js / firebase-messaging-sw.js)
# are self-destruct kill switches for orphaned workers from earlier iterations;
# web-push-sw.js is the current, active push worker. All must be revalidated on
# every update check so returning visitors always get the latest script.
/sw.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate
/service-worker.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate
/firebase-messaging-sw.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate
/web-push-sw.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate
